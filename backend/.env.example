# ─────────────────────────────────────────────────────────────────────────────
# SWASTHYASETU BACKEND CONFIGURATION (.env.example)
# ─────────────────────────────────────────────────────────────────────────────

# Server Port
PORT=5000

# Environment Mode: 'development' or 'production'
NODE_ENV=development

# MongoDB Atlas / Local Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/swasthyasetu?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.xxxxx.mongodb.net/?appName=Cluster0

# Mandatory JWT Secret for signing & validating auth tokens
# Generate a strong 64-char key in production: e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here_minimum_32_characters

# Allowed Frontend URLs for CORS (comma-separated without trailing slash)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# Initial Super Admin Setup (Used during first seed/init)
# Required when running: npm run init:admin
SUPERADMIN_INITIAL_PASSWORD=YourStrongSuperAdminPassword@2026

# Optional: Demo/Simulated queries flag (false = live real MongoDB queries)
DEMO_MODE=false

# ─────────────────────────────────────────────────────────────────────────────
# AI TRANSLATION KEYS (OPTIONAL)
# If left empty, high-speed free Google Translate proxy engine is used by default.
# ─────────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
